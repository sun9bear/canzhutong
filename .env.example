# Copy to .env.local and fill in values. Never commit real secrets.
#
# Leave DATABASE_URL empty for local embedded PGLite (no external Postgres needed).
# When DATABASE_URL is set (Neon / production), also set BETTER_AUTH_SECRET and ADMIN_EMAILS.
DATABASE_URL=

# Better Auth — required when DATABASE_URL is set (encrypts sessions / AI API keys).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Comma-separated admin emails. When DATABASE_URL is set and this is empty → no admins (fail closed).
ADMIN_EMAILS=

# Public email *sign-up* (sign-in stays on). Default ON in production and local.
# Set to false to disable registration. ADMIN_EMAILS still cannot register (hard gate).
ALLOW_EMAIL_SIGNUP=
# Rebuild required for the login 注册 toggle. Default shows 注册; set false to hide it.
VITE_ALLOW_EMAIL_SIGNUP=

# Optional: also require user.emailVerified in requireAdmin. Do NOT enable —
# ADMIN_EMAILS and existing admins are not required to verify.
REQUIRE_ADMIN_EMAIL_VERIFIED=

# Resend — 6-digit email OTP (codes, not magic links). Required to actually send.
# If unset in local/dev, send fails with「验证邮件暂时发不出」; login still works.
RESEND_API_KEY=
# Optional From override. Default: 残助通 <beth.t@example.com>
RESEND_FROM=

# Optional DeepSeek env fallback when admin AI settings are not configured in the DB.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
