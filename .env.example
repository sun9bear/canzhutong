# Copy to .env.local and fill in values. Never commit real secrets.
#
# Leave DATABASE_URL empty for local embedded PGLite (no external Postgres needed).
# When DATABASE_URL is set (Neon / production), also set BETTER_AUTH_SECRET and ADMIN_EMAILS.
DATABASE_URL=

# Better Auth — required when DATABASE_URL is set (encrypts sessions / AI API keys).
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:8080

# Comma-separated admin emails. When DATABASE_URL is set and this is empty → no admins (fail closed).
ADMIN_EMAILS=

# Public email *sign-up* (sign-in stays on). Default OFF when DATABASE_URL is set.
# Set to true only to bootstrap a user, then unset. Existing admins just sign in.
ALLOW_EMAIL_SIGNUP=
# Rebuild required for the login 注册 toggle. Production builds hide 注册 unless this is true.
VITE_ALLOW_EMAIL_SIGNUP=

# Optional: also require user.emailVerified in requireAdmin. Do NOT enable until SMTP
# verification is configured — password users stay unverified and the real admin would lock out.
REQUIRE_ADMIN_EMAIL_VERIFIED=

# Optional DeepSeek env fallback when admin AI settings are not configured in the DB.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
