# WeChat mini-program AppID
# Also set src/manifest.json mp-weixin.appid
VITE_MP_APPID=

# H5 origin serving public/data/policies.json
# First match: VITE_API_BASE, then VITE_MP_DATA_BASE, then https://canzhutong.vercel.app
# Local: http://127.0.0.1:8080 after exporting mp:data and starting H5
VITE_API_BASE=
VITE_MP_DATA_BASE=
